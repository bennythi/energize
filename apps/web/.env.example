# Pocketbase (public API-URL, darf ins Bundle - Schutz via Collection-Rules)
# Lokal: http://127.0.0.1:8090  ·  Produktion: https://api.<domain>
PUBLIC_PB_URL=http://127.0.0.1:8090

# Sanity Cloud (public, noch fuer oeffentliche Inhalte; Migration auf Directus geplant)
PUBLIC_SANITY_PROJECT_ID=oxliq7rf
PUBLIC_SANITY_DATASET=production

# Sentry Error-Monitoring (public, DSN ist absichtlich oeffentlich).
# Leer = deaktiviert. Aktiv nur auf der Produktionsdomain (hooks.client.ts).
PUBLIC_SENTRY_DSN=
